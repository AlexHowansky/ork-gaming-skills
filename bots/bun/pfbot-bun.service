# Sample systemd unit. Replace /path/to/ork-pf2e-tools and YOUR_USER, then:
#   sudo cp bots/bun/pfbot-bun.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pfbot-bun
[Unit]
Description=PF2e/SF2e Discord lookup bot (Bun)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/ork-pf2e-tools/bots/bun
EnvironmentFile=/path/to/ork-pf2e-tools/bots/bun/.env
ExecStart=/home/YOUR_USER/.bun/bin/bun src/bot.ts
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
