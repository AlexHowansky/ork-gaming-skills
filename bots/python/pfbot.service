# Sample systemd unit. Replace /path/to/ork-gaming-skills and YOUR_USER, then:
#   sudo cp bots/python/pfbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pfbot
[Unit]
Description=PF2e/SF2e Discord lookup bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/ork-gaming-skills
EnvironmentFile=/path/to/ork-gaming-skills/bots/python/pfbot.env
ExecStart=/path/to/ork-gaming-skills/bots/python/.venv/bin/python bots/python/pfbot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
