# Sample systemd unit. Replace /path/to/ork-pf2e-tools and YOUR_USER, then:
#   sudo cp bot/pfbot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pfbot
[Unit]
Description=PF2e/SF2e Discord lookup bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/ork-pf2e-tools
EnvironmentFile=/path/to/ork-pf2e-tools/bot/pfbot.env
ExecStart=/path/to/ork-pf2e-tools/bot/.venv/bin/python bot/pfbot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
