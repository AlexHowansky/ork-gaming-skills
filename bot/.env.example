# Copy to bot/.env and fill in (Bun loads it automatically). Keep it private (chmod 600).
DISCORD_TOKEN=
# Optional: data directory (default: skill/pf2e/data in this repo)
#PF_DATA=
# Optional: HERO data directory for /hero (default: skill/hero/data in this repo)
#HERO_DATA=
# Optional: HERO editions /hero answers with, comma-separated from 6e, 5e (default: both)
#HERO_EDITIONS=
# Optional: sync commands to one server only (instant; use while testing)
#PF_GUILD_ID=
